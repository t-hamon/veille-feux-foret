# Fail fast with a clear message when Node.js is older than the engines field allows,
# instead of installing and breaking later with obscure errors.
engine-strict=true
# Never resolve a version published less than seven days ago: compromised or broken
# releases are usually caught and withdrawn within days. Requires npm 11.10 or later,
# which every Node.js version allowed by engines ships with.
min-release-age=7
